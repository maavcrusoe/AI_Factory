# Copiar a .env (nunca commitear .env). Valores de ejemplo: CAMBIAR antes de desplegar.
# Generar secretos: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# PostgreSQL (docker compose lee este fichero). Usa solo letras y números en la contraseña:
# se inserta sin codificar en DATABASE_URL del contenedor.
POSTGRES_PORT=5432
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory
POSTGRES_DB=factory

# Compose: publicación en el host. 127.0.0.1 = solo esta máquina; en el servidor, IP de la LAN o 0.0.0.0.
API_BIND=127.0.0.1
API_PORT=8000
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3000

# API (apps/api). Compose sobrescribe DATABASE_URL para apuntar al servicio `db`.
DATABASE_URL=postgresql+psycopg://factory:factory@localhost:5432/factory
TEST_DATABASE_URL=postgresql+psycopg://factory:factory@localhost:5432/factory_test
APP_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=cambiar-admin-password
# Clave Fernet para cifrar tokens de proyecto. Varias claves separadas por coma: la primera cifra (ver runbook de rotación).
TOKEN_ENCRYPTION_KEY=cambiar-por-clave-fernet

# Logs: json (producción, Docker) o text (desarrollo).
LOG_FORMAT=json
LOG_LEVEL=INFO
